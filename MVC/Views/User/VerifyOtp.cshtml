@{
    ViewData["Title"] = "Verify OTP";
    Layout = null;

    // Pass server error to JS so we know if OTP was already expired
    bool isExpired = ViewBag.Error != null &&
                     ViewBag.Error.ToString().Contains("expired");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP</title>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.1.130/styles/kendo.default-v2.min.css" />
    <script src="https://kendo.cdn.telerik.com/2024.1.130/js/kendo.all.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0,0,0,.30);
            overflow: hidden;
        }

        .header {
            padding: 2rem;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        .header .icon {
            font-size: 2.2rem;
            color: #0d6efd;
            margin-bottom: .4rem;
        }

        .header h2 {
            margin: 0;
            font-weight: 800;
            color: #1e293b;
        }

        .header p {
            margin: .3rem 0 0;
            font-size: .9rem;
            color: #6c757d;
        }

        .body {
            padding: 2rem;
        }

        .otp-input {
            width: 100%;
            height: 54px;
            border-radius: 10px;
            border: 2px solid #dee2e6;
            padding: 0 1rem;
            font-size: 1.4rem;
            text-align: center;
            letter-spacing: 10px;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }

        .otp-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
        }

        .btn-verify {
            width: 100%;
            height: 50px;
            margin-top: 1rem;
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg, #0d6efd, #084298);
            color: white;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all .25s;
            box-shadow: 0 8px 24px rgba(13,110,253,.30);
        }

        .btn-verify:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(13,110,253,.40);
        }

        .error-box {
            margin-top: 12px;
            padding: 8px 12px;
            background: rgba(220,53,69,.08);
            border-left: 4px solid #dc3545;
            border-radius: 6px;
            font-size: .85rem;
            font-weight: 600;
            color: #dc3545;
        }

        .timer {
            text-align: center;
            margin-top: 14px;
            font-size: .88rem;
            color: #6c757d;
        }

        .timer span {
            font-weight: 700;
            color: #0d6efd;
        }

        .timer span.expired {
            color: #dc3545;
        }

        .btn-resend {
            width: 100%;
            margin-top: 10px;
            padding: 11px;
            border-radius: 10px;
            border: 2px solid #0d6efd;
            background: white;
            color: #0d6efd;
            font-weight: 600;
            font-size: .92rem;
            cursor: pointer;
            transition: all .2s;
        }

        .btn-resend:hover:not(:disabled) {
            background: #eef2ff;
        }

        .btn-resend:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .resend-success {
            display: none;
            margin-top: 10px;
            padding: 7px 12px;
            background: rgba(25,135,84,.1);
            border-left: 4px solid #198754;
            border-radius: 6px;
            font-size: .84rem;
            font-weight: 600;
            color: #198754;
        }
    </style>
</head>

<body>

<div class="card">

    <div class="header">
        <div class="icon"><i class="fa fa-shield-halved"></i></div>
        <h2>Verify OTP</h2>
        <p>Enter the 4-digit code sent to your email</p>
    </div>

    <div class="body">

        <form method="post" action="/user/verify-otp">
            @Html.AntiForgeryToken()

            <input type="text"
                   name="otp"
                   class="otp-input"
                   placeholder="- - - -"
                   maxlength="4"
                   autocomplete="one-time-code"
                   inputmode="numeric"
                   required />

            <button type="submit" class="btn-verify">
                <i class="fa fa-check"></i>&nbsp; Verify OTP
            </button>

            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    <i class="fa fa-circle-exclamation"></i> @ViewBag.Error
                </div>
            }

            <div class="timer">
                OTP expires in: <span id="timerDisplay">01:00</span>
            </div>

            <button type="button" id="resendBtn" class="btn-resend" disabled>
                <i class="fa fa-rotate-right"></i>&nbsp; Resend OTP
            </button>

            <div class="resend-success" id="resendSuccess">
                <i class="fa fa-circle-check"></i> New OTP sent to your email!
            </div>

        </form>

    </div>
</div>

<script>
    const OTP_DURATION = 60;
    const STORAGE_KEY  = "otp_expiry";

    // ✅ Razor tells JS whether the server rejected with "expired"
    const serverSaysExpired = @(isExpired ? "true" : "false");

    const timerEl   = document.getElementById("timerDisplay");
    const resendBtn = document.getElementById("resendBtn");

    function formatTime(secs) {
        const m = Math.floor(secs / 60).toString().padStart(1, "0");
        const s = (secs % 60).toString().padStart(2, "0");
        return `${m}:${s}`;
    }

    function showExpired() {
        timerEl.textContent = "Expired";
        timerEl.classList.add("expired");
        resendBtn.disabled = false;   // ✅ enable resend immediately
    }

    let timerInterval = null;

    function startTimer() {
        clearInterval(timerInterval);
        resendBtn.disabled = true;
        timerEl.classList.remove("expired");

        timerInterval = setInterval(() => {
            const expiry    = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
            const remaining = Math.max(0, Math.floor((expiry - Date.now()) / 1000));

            if (remaining <= 0) {
                clearInterval(timerInterval);
                showExpired();
                return;
            }

            timerEl.textContent = formatTime(remaining);
        }, 1000);
    }

    // ── On page load ──
    if (serverSaysExpired) {
        // ✅ Server confirmed OTP is expired:
        //    - clear stale expiry so no timer runs
        //    - show "Expired" immediately
        //    - keep Resend button ENABLED right away
        localStorage.removeItem(STORAGE_KEY);
        showExpired();
    } else {
        // Fresh load or wrong-OTP retry → always start a fresh timer
        localStorage.setItem(STORAGE_KEY, Date.now() + OTP_DURATION * 1000);
        startTimer();
    }

    // ── Resend OTP ──
    resendBtn.addEventListener("click", function () {
        resendBtn.disabled = true;
        resendBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>&nbsp; Sending...';
        document.getElementById("resendSuccess").style.display = "none";

        $.ajax({
            url:  "/user/resend-otp",
            type: "POST",
            @* headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            }, *@
            success: function () {
                // New OTP sent → reset timer fresh
                localStorage.setItem(STORAGE_KEY, Date.now() + OTP_DURATION * 1000);
                resendBtn.innerHTML = '<i class="fa fa-rotate-right"></i>&nbsp; Resend OTP';
                document.getElementById("resendSuccess").style.display = "block";
                startTimer();
            },
            error: function () {
                resendBtn.disabled = false;
                resendBtn.innerHTML = '<i class="fa fa-rotate-right"></i>&nbsp; Resend OTP';
                alert("Failed to resend OTP. Please try again.");
            }
        });
    });
</script>

</body>
</html>
