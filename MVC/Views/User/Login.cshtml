@model Repository.Models.UserLoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <!-- jQuery (required by Kendo) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Kendo UI -->
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.1.130/styles/kendo.default-v2.min.css" />
    <script src="https://kendo.cdn.telerik.com/2024.1.130/js/kendo.all.min.js"></script>

    <!-- Font Awesome for field icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* ── Card ── */
        .login-card {
            width: 100%;
            max-width: 440px;
            margin: 1.5rem;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0,0,0,.30);
            overflow: hidden;
        }

        /* ── Header banner ── */
        .login-header {
            background: #fff;
            padding: 2.2rem 2rem 1.8rem;
            text-align: center;
            color: #1e293b;
            border-bottom: 1px solid #e9ecef;
        }
        .login-header .logo-icon {
            font-size: 2.4rem;
            margin-bottom: .5rem;
            color: #0d6efd;
        }
        .login-header h2 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -.02em;
            color: #1e293b;
        }
        .login-header p {
            margin: .3rem 0 0;
            font-size: .9rem;
            color: #6c757d;
        }
        .login-hero {
            padding: 1rem 1.5rem 0;
            background: #fff;
            text-align: center;
        }
        .login-hero img {
            width: 100%;
            max-width: 250px;
            height: auto;
            display: inline-block;
        }

        /* ── Body ── */
        .login-body {
            padding: 1rem 2.2rem 2.2rem;
        }

        /* ── Icon wrapper around Kendo TextBox ── */
        .input-icon {
            position: relative;
        }
        .input-icon .fa {
            position: absolute;
            top: 24px;
            left: 1rem;
            transform: translateY(-50%);
            color: #0d6efd;
            font-size: 1rem;
            z-index: 10;
            pointer-events: none;
        }
        .input-icon .k-textbox,
        .input-icon .k-input {
            padding-left: 2.8rem !important;
        }
        .input-icon .k-input-inner {
            padding-left: 2.8rem !important;
        }

        /* ── Eye-toggle wrapper (password field) ── */
        .pwd-wrap {
            position: relative;
        }
        .pwd-wrap .fa-lock {
            position: absolute;
            top: 24px;
            left: 1rem;
            transform: translateY(-50%);
            color: #0d6efd;
            font-size: 1rem;
            z-index: 10;
            pointer-events: none;
        }
        .pwd-wrap .k-textbox,
        .pwd-wrap .k-input {
            padding-left: 2.8rem !important;
            padding-right: 3rem  !important;
        }
        .pwd-wrap .k-input-inner {
            padding-left: 2.8rem !important;
            padding-right: 3rem  !important;
        }
        #eyeToggle {
            position: absolute;
            right: .6rem;
            top: 24px;
            transform: translateY(-50%);
            z-index: 10;
            background: transparent;
            border: none;
            color: #6c757d;
            cursor: pointer;
            padding: .25rem .4rem;
            border-radius: 6px;
            transition: color .2s;
        }
        #eyeToggle:hover { color: #0d6efd; }

        /* ── Forgot Password link ── */
        .forgot-pwd-wrap {
            text-align: right;
            margin-top: .4rem;
            margin-bottom: -.6rem;
        }
        .forgot-pwd-wrap a {
            font-size: .83rem;
            font-weight: 600;
            color: #0d6efd;
            text-decoration: none;
            transition: color .2s;
        }
        .forgot-pwd-wrap a:hover {
            color: #084298;
            text-decoration: underline;
        }

        /* ── Kendo TextBox global overrides ── */
        .k-textbox,
        .k-input {
            width: 100% !important;
            height: 48px !important;
            border-radius: 10px !important;
            border: 2px solid #dee2e6 !important;
            background: #f8f9ff !important;
            font-size: .97rem !important;
            color: #212529 !important;
            transition: border-color .2s, box-shadow .2s !important;
        }
        .k-textbox:hover,
        .k-input:hover {
            border-color: #0d6efd !important;
        }
        .k-textbox.k-focus,
        .k-input.k-focus,
        .k-textbox:focus-within,
        .k-input:focus-within {
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.15) !important;
            background: #fff !important;
        }
        .k-input-inner {
            background: transparent !important;
            border: none !important;
            height: 100% !important;
            font-size: .97rem !important;
        }

        /* ── Kendo Form field spacing ── */
        .k-form .k-form-field {
            margin-bottom: 1.4rem;
        }
        .k-form .k-label,
        .k-form .k-form-label {
            font-weight: 700;
            font-size: .85rem;
            color: #1e293b;
            letter-spacing: .03em;
            text-transform: uppercase;
            margin-bottom: .5rem;
        }

        /* ── Kendo validation error ── */
        .k-form-error,
        .field-validation-error {
            display: block !important;
            margin-top: 6px !important;
            padding: 5px 10px !important;
            font-size: .82rem !important;
            font-weight: 600 !important;
            color: #dc3545 !important;
            background: rgba(220,53,69,.08) !important;
            border-left: 4px solid #dc3545 !important;
            border-radius: 6px !important;
            animation: fadeIn .2s ease !important;
        }
        .field-validation-valid { display: none !important; }

        /* server-side summary */
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem;
        }
        .validation-summary-errors li {
            padding: 6px 10px;
            font-size: .83rem;
            font-weight: 600;
            color: #dc3545;
            background: rgba(220,53,69,.08);
            border-left: 4px solid #dc3545;
            border-radius: 6px;
            margin-bottom: 4px;
        }

        /* ── Sign-In Kendo Button ── */
        #loginBtn.k-button {
            width: 100% !important;
            height: 50px !important;
            border-radius: 10px !important;
            border: none !important;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%) !important;
            color: #fff !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            letter-spacing: .04em !important;
            box-shadow: 0 8px 24px rgba(13,110,253,.35) !important;
            transition: all .25s !important;
            margin-top: .5rem;
        }
        #loginBtn.k-button:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 14px 32px rgba(13,110,253,.45) !important;
        }
        #loginBtn.k-button:active {
            transform: translateY(0) !important;
        }

        /* ── Employee link at bottom ── */
        .emp-link-wrap {
            margin-top: 1.4rem;
        }
        .emp-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1rem;
        }
        .emp-divider hr {
            flex: 1;
            margin: 0;
            border-color: #dee2e6;
        }
        .emp-divider span {
            font-size: .8rem;
            color: #adb5bd;
            white-space: nowrap;
        }
        .btn-emp {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 11px;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            background: #f8f9fa;
            color: #495057;
            font-weight: 600;
            font-size: .92rem;
            text-decoration: none;
            transition: all .2s;
        }
        .btn-emp:hover {
            background: #eef2ff;
            border-color: #0d6efd;
            color: #0d6efd;
        }

        /* ── Register link ── */
        .register-link {
            text-align: center;
            margin-top: 1.1rem;
            font-size: .88rem;
            color: #6c757d;
        }
        .register-link a {
            color: #0d6efd;
            font-weight: 600;
            text-decoration: none;
        }
        .register-link a:hover { text-decoration: underline; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-3px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="login-card">

    <!-- Header -->
    <div class="login-header">
        <div class="logo-icon"><i class="fa fa-headset"></i></div>
        <h2>Query Management</h2>
        <p>Sign in to continue</p>
        <div style="display:inline-block;margin-top:.75rem;background:#eef2ff;border:1.5px solid #0d6efd;border-radius:20px;padding:.3rem 1.1rem;font-size:.85rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#0d6efd;">
            <i class="fa fa-user me-1"></i>Login as User
        </div>
    </div>
    <div class="login-hero">
        <img src="~/images/userquery.png" alt="User login illustration" />
    </div>

    <!-- Body -->
    <div class="login-body">

        @if (TempData["Success"] != null)
        {
            <div style="padding:8px 12px;margin-bottom:1rem;background:rgba(25,135,84,.1);border-left:4px solid #198754;border-radius:6px;font-size:.86rem;font-weight:600;color:#198754;">
                <i class="fa fa-circle-check me-1"></i>@TempData["Success"]
            </div>
        }

        <!-- Server-side validation summary -->
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <!-- Kendo Form -->
        <form id="loginForm" method="post" asp-action="Login" asp-controller="User">
            @Html.AntiForgeryToken()
            <div id="formContainer"></div>
            <input type="hidden" name="returnUrl" value="/user/dashboard" />
        </form>

        <!-- Register link -->
        <div class="register-link">
            Don't have an account?
            <a asp-action="Register" asp-controller="User">Register here</a>
        </div>

        <!-- Employee / Admin link -->
        <div class="emp-link-wrap">
            <div class="emp-divider">
                <hr /><span>or</span><hr />
            </div>
            <a href="/Employee/Login" class="btn-emp">
                <i class="fa fa-user-tie"></i>
                Login as Employee / Admin
            </a>
        </div>

    </div><!-- /login-body -->
</div><!-- /login-card -->

<script>
$(document).ready(function () {

    // ── Build Kendo Form ──
    var form = $("#loginForm").kendoForm({
        formData: {
            Email:    "",
            Password: ""
        },
        layout: "vertical",
        items: [
            {
                field: "Email",
                label: "Email Address",
                validation: { required: true, email: true },
                editor: function (container, options) {
                    $('<div class="input-icon">' +
                        '<i class="fa fa-envelope"></i>' +
                        '<input required ' +
                               'type="email" ' +
                               'data-required-msg="Email is required" ' +
                               'data-email-msg="Enter a valid email" ' +
                               'class="k-textbox" ' +
                               'name="Email" ' +
                               'id="emailInput" ' +
                               'placeholder="Enter your email" />' +
                      '</div>').appendTo(container);
                }
            },
            {
                field: "Password",
                label: "Password",
                validation: { required: true },
                editor: function (container, options) {
                    $('<div class="pwd-wrap">' +
                        '<i class="fa fa-lock"></i>' +
                        '<input required ' +
                               'type="password" ' +
                               'data-required-msg="Password is required" ' +
                               'class="k-textbox" ' +
                               'name="Password" ' +
                               'id="pwdInput" ' +
                               'placeholder="Enter your password" />' +
                        '<button type="button" id="eyeToggle" title="Show / hide password">' +
                            '<i class="fa fa-eye" id="eyeIcon"></i>' +
                        '</button>' +
                      '</div>' +
                      '<div class="forgot-pwd-wrap">' +
                          '<a href="/user/forgot-password"><i class="fa fa-key"></i> Forgot Password?</a>' +
                      '</div>').appendTo(container);
                }
            }
        ],
        buttonsTemplate:
            '<div style="margin-top:.25rem">' +
                '<button id="loginBtn" type="submit" class="k-button">' +
                    '<i class="fa fa-arrow-right-to-bracket"></i>&nbsp; Sign In' +
                '</button>' +
            '</div>'
    }).data("kendoForm");

    // ── Kendo Button widget ──
    $("#loginBtn").kendoButton({ themeColor: "primary" });

    // ── Eye toggle ──
    $(document).on("click", "#eyeToggle", function (e) {
        e.preventDefault();
        var pwd  = $("#pwdInput");
        var icon = $("#eyeIcon");
        if (pwd.attr("type") === "password") {
            pwd.attr("type", "text");
            icon.removeClass("fa-eye").addClass("fa-eye-slash");
        } else {
            pwd.attr("type", "password");
            icon.removeClass("fa-eye-slash").addClass("fa-eye");
        }
    });

    // ── Submit: validate before post ──
    $("#loginForm").on("submit", function (e) {
        e.preventDefault();
        if (form.validate()) {
            this.submit();
        }   
    });

    // ── Auto-focus ──
    setTimeout(function () { $("#emailInput").focus(); }, 150);
});
</script>
</body>
</html>
