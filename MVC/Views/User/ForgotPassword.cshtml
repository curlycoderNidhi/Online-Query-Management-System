@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password</title>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0,0,0,.30);
            overflow: hidden;
        }

        .header {
            padding: 2rem 2rem 1.5rem;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        .header h2 {
            margin: 0;
            font-weight: 700;
            color: #1e293b;
        }

        .header p {
            margin-top: 6px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .body {
            padding: 2rem;
        }

        .input {
            width: 100%;
            height: 50px;
            border-radius: 10px;
            border: 2px solid #dee2e6;
            padding: 0 1rem;
            font-size: 0.95rem;
            transition: 0.2s;
        }

        .input:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.1);
        }

        .btn {
            width: 100%;
            height: 50px;
            margin-top: 1rem;
            border-radius: 10px;
            background: linear-gradient(135deg, #0d6efd, #084298);
            color: white;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(13,110,253,0.3);
        }

        .error {
            color: red;
            text-align: center;
            margin-top: 10px;
            font-size: 0.85rem;
        }
    </style>
</head>

<body>

<div class="card">
    <div class="header">
        <h2>Forgot Password</h2>
        <p>Enter your email</p>
    </div>

    <div class="body">
        <form method="post" asp-action="ForgotPassword" asp-controller="User">

            <input type="email"
                   name="email"
                   class="input"
                   placeholder="Enter your email"
                   required />

            <button type="submit" class="btn">
                Send OTP
            </button>

            <div class="error">@ViewBag.Error</div>

        </form>
    </div>
</div>

</body>
</html>