@model MVC.Models.UserSignupViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>

    <!-- jQuery (required by Kendo) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Kendo UI -->
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.1.130/styles/kendo.default-v2.min.css" />
    <script src="https://kendo.cdn.telerik.com/2024.1.130/js/kendo.all.min.js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            padding: 1.5rem 0;
        }

        /* ── Card ── */
        .login-card {
            width: 100%;
            max-width: 460px;
            margin: 1.5rem;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0,0,0,.30);
            overflow: hidden;
        }

        /* ── Header ── */
        .login-header {
            background: #fff;
            padding: 2.2rem 2rem 1.8rem;
            text-align: center;
            color: #1e293b;
            border-bottom: 1px solid #e9ecef;
        }
        .login-header .logo-icon {
            font-size: 2.4rem;
            margin-bottom: .5rem;
            color: #0d6efd;
        }
        .login-header h2 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -.02em;
            color: #1e293b;
        }
        .login-header p {
            margin: .3rem 0 0;
            font-size: .9rem;
            color: #6c757d;
        }
        .login-header .role-badge {
            display: inline-block;
            margin-top: .75rem;
            background: rgba(255,255,255,.18);
            border: 1.5px solid rgba(255,255,255,.4);
            border-radius: 20px;
            padding: .3rem 1.1rem;
            font-size: .85rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        /* ── Body ── */
        .login-body {
            padding: 2rem 2.2rem 2.2rem;
        }

        /* ── Icon wrapper ── */
        .input-icon {
            position: relative;
        }
        .input-icon .fa {
            position: absolute;
            top: 24px;
            left: 1rem;
            transform: translateY(-50%);
            color: #0d6efd;
            font-size: 1rem;
            z-index: 10;
            pointer-events: none;
        }
        .input-icon .k-textbox,
        .input-icon .k-input {
            padding-left: 2.8rem !important;
        }
        .input-icon .k-input-inner {
            padding-left: 2.8rem !important;
        }

        /* ── Password eye toggle ── */
        .pwd-wrap {
            position: relative;
        }
        .pwd-wrap .fa-lock,
        .pwd-wrap .fa-lock-open {
            position: absolute;
            top: 24px;
            left: 1rem;
            transform: translateY(-50%);
            color: #0d6efd;
            font-size: 1rem;
            z-index: 10;
            pointer-events: none;
        }
        .pwd-wrap .k-textbox,
        .pwd-wrap .k-input {
            padding-left: 2.8rem !important;
            padding-right: 3rem !important;
        }
        .pwd-wrap .k-input-inner {
            padding-left: 2.8rem !important;
            padding-right: 3rem !important;
        }
        .eye-btn {
            position: absolute;
            right: .6rem;
            top: 24px;
            transform: translateY(-50%);
            z-index: 10;
            background: transparent;
            border: none;
            color: #6c757d;
            cursor: pointer;
            padding: .25rem .4rem;
            border-radius: 6px;
            transition: color .2s;
        }
        .eye-btn:hover { color: #0d6efd; }

        /* ── Kendo TextBox overrides ── */
        .k-textbox,
        .k-input {
            width: 100% !important;
            height: 48px !important;
            border-radius: 10px !important;
            border: 2px solid #dee2e6 !important;
            background: #f8f9ff !important;
            font-size: .97rem !important;
            color: #212529 !important;
            transition: border-color .2s, box-shadow .2s !important;
        }
        .k-textbox:hover, .k-input:hover {
            border-color: #0d6efd !important;
        }
        .k-textbox.k-focus, .k-input.k-focus,
        .k-textbox:focus-within, .k-input:focus-within {
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.15) !important;
            background: #fff !important;
        }
        .k-input-inner {
            background: transparent !important;
            border: none !important;
            height: 100% !important;
            font-size: .97rem !important;
        }

        /* ── Kendo Form labels ── */
        .k-form .k-form-field {
            margin-bottom: 1.3rem;
        }
        .k-form .k-label,
        .k-form .k-form-label {
            font-weight: 700;
            font-size: .85rem;
            color: #1e293b;
            letter-spacing: .03em;
            text-transform: uppercase;
            margin-bottom: .5rem;
        }

        /* ── Validation errors ── */
        .k-form-error,
        .field-validation-error {
            display: block !important;
            margin-top: 6px !important;
            padding: 5px 10px !important;
            font-size: .82rem !important;
            font-weight: 600 !important;
            color: #dc3545 !important;
            background: rgba(220,53,69,.08) !important;
            border-left: 4px solid #dc3545 !important;
            border-radius: 6px !important;
            animation: fadeIn .2s ease !important;
        }
        .field-validation-valid { display: none !important; }

        /* server-side summary */
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem;
        }
        .validation-summary-errors li {
            padding: 6px 10px;
            font-size: .83rem;
            font-weight: 600;
            color: #dc3545;
            background: rgba(220,53,69,.08);
            border-left: 4px solid #dc3545;
            border-radius: 6px;
            margin-bottom: 4px;
        }

        /* ── Register button ── */
        #registerBtn.k-button {
            width: 100% !important;
            height: 50px !important;
            border-radius: 10px !important;
            border: none !important;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%) !important;
            color: #fff !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            letter-spacing: .04em !important;
            box-shadow: 0 8px 24px rgba(13,110,253,.35) !important;
            transition: all .25s !important;
            margin-top: .25rem;
        }
        #registerBtn.k-button:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 14px 32px rgba(13,110,253,.45) !important;
        }
        #registerBtn.k-button:active {
            transform: translateY(0) !important;
        }

        /* ── Login link ── */
        .login-link {
            text-align: center;
            margin-top: 1.2rem;
            font-size: .88rem;
            color: #6c757d;
        }
        .login-link a {
            color: #0d6efd;
            font-weight: 600;
            text-decoration: none;
        }
        .login-link a:hover { text-decoration: underline; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-3px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="login-card">

    <!-- Header -->
    <div class="login-header">
        <div class="logo-icon"><i class="fa fa-user-plus"></i></div>
        <h2>Create Account</h2>
        <p>Register to submit queries</p>
        <div class="role-badge">
            <i class="fa fa-pen me-1"></i>New Registration
        </div>
    </div>

    <!-- Body -->
    <div class="login-body">

        <!-- Server-side validation summary -->
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <!-- Kendo Form -->
        <form id="registerForm" method="post" asp-action="Register" asp-controller="User">
            @Html.AntiForgeryToken()
        </form>

        <!-- Login link -->
        <div class="login-link">
            Already have an account?
            <a asp-action="Login" asp-controller="User">Sign in</a>
        </div>

    </div>
</div>

<script>
$(document).ready(function () {

    var form = $("#registerForm").kendoForm({
        formData: {
            CompanyName: "",
            Email:       "",
            Password:    "",
            ConfirmPassword: ""
        },
        items: [
            {
                field: "CompanyName",
                label: "Company Name",
                editor: function (container, options) {
                    $('<div class="input-icon">' +
                        '<i class="fa fa-building"></i>' +
                        '<input required ' +
                               'type="text" ' +
                               'data-required-msg="Company name is required" ' +
                               'class="k-textbox" ' +
                               'name="' + options.field + '" ' +
                               'id="companyInput" ' +
                               'placeholder="Your company name" />' +
                      '</div>').appendTo(container);
                }
            },
            {
                field: "Email",
                label: "Email Address",
                editor: function (container, options) {
                    $('<div class="input-icon">' +
                        '<i class="fa fa-envelope"></i>' +
                        '<input required ' +
                               'type="email" ' +
                               'data-required-msg="Email is required" ' +
                               'data-email-msg="Enter a valid email" ' +
                               'class="k-textbox" ' +
                               'name="' + options.field + '" ' +
                               'id="emailInput" ' +
                               'placeholder="you@company.com" />' +
                      '</div>').appendTo(container);
                }
            },
            {
                field: "Password",
                label: "Password",
                editor: function (container, options) {
                    $('<div class="pwd-wrap">' +
                        '<i class="fa fa-lock"></i>' +
                        '<input required ' +
                               'type="password" ' +
                               'data-required-msg="Password is required" ' +
                               'data-minlength="6" ' +
                               'data-minlength-msg="Password must be at least 6 characters" ' +
                               'class="k-textbox" ' +
                               'name="' + options.field + '" ' +
                               'id="pwdInput" ' +
                               'placeholder="Min 6 characters" />' +
                        '<button type="button" class="eye-btn" id="eyePwd">' +
                            '<i class="fa fa-eye" id="eyePwdIcon"></i>' +
                        '</button>' +
                      '</div>').appendTo(container);
                }
            },
            {
                field: "ConfirmPassword",
                label: "Confirm Password",
                editor: function (container, options) {
                    $('<div class="pwd-wrap">' +
                        '<i class="fa fa-lock"></i>' +
                        '<input required ' +
                               'type="password" ' +
                               'data-required-msg="Please confirm your password" ' +
                               'class="k-textbox" ' +
                               'name="ConfirmPassword" ' +
                               'id="confirmPwdInput" ' +
                               'placeholder="Re-enter password" />' +
                        '<button type="button" class="eye-btn" id="eyeConfirm">' +
                            '<i class="fa fa-eye" id="eyeConfirmIcon"></i>' +
                        '</button>' +
                      '</div>').appendTo(container);
                }
            }
        ],
        buttonsTemplate:
            '<div style="margin-top:.5rem">' +
                '<button id="registerBtn" type="submit" class="k-button">' +
                    '<i class="fa fa-user-check"></i>&nbsp; Register' +
                '</button>' +
            '</div>'
    }).data("kendoForm");

    // ── Kendo Button ──
    $("#registerBtn").kendoButton({ themeColor: "primary" });

    // ── Eye toggles ──
    $(document).on("click", "#eyePwd", function () {
        var el = $("#pwdInput"), icon = $("#eyePwdIcon");
        el.attr("type") === "password"
            ? (el.attr("type", "text"),  icon.removeClass("fa-eye").addClass("fa-eye-slash"))
            : (el.attr("type", "password"), icon.removeClass("fa-eye-slash").addClass("fa-eye"));
    });
    $(document).on("click", "#eyeConfirm", function () {
        var el = $("#confirmPwdInput"), icon = $("#eyeConfirmIcon");
        el.attr("type") === "password"
            ? (el.attr("type", "text"),  icon.removeClass("fa-eye").addClass("fa-eye-slash"))
            : (el.attr("type", "password"), icon.removeClass("fa-eye-slash").addClass("fa-eye"));
    });

    // ── Submit: validate + confirm password match ──
    $("#registerForm").on("submit", function (e) {
        if (!form.validate()) {
            e.preventDefault();
            return;
        }
        if ($("#pwdInput").val() !== $("#confirmPwdInput").val()) {
            e.preventDefault();
            var errHtml = '<span class="k-form-error" id="confirmErr">Passwords do not match.</span>';
            if ($("#confirmErr").length === 0) {
                $("#confirmPwdInput").closest(".pwd-wrap").after(errHtml);
            }
            return;
        }
        $("#confirmErr").remove();
    });

    // ── Clear confirm-match error on type ──
    $(document).on("input", "#confirmPwdInput, #pwdInput", function () {
        $("#confirmErr").remove();
    });

    // ── Auto-focus ──
    setTimeout(function () { $("#companyInput").focus(); }, 150);
});
</script>
</body>
</html>
