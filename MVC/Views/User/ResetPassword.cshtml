@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password</title>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0,0,0,.30);
            overflow: hidden;
        }

        .header {
            padding: 2rem;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        .header h2 {
            margin: 0;
            font-weight: 700;
            color: #1e293b;
        }

        .body {
            padding: 2rem;
        }

        .input {
            width: 100%;
            height: 50px;
            border-radius: 10px;
            border: 2px solid #dee2e6;
            padding: 0 1rem;
            margin-bottom: 10px;
            font-size: 0.95rem;
            transition: 0.2s;
        }

        .input:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.1);
        }

        .btn {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, #0d6efd, #084298);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(13,110,253,0.3);
        }

        .error {
            color: red;
            text-align: center;
            font-size: 0.85rem;
            margin-top: 5px;
        }
    </style>
</head>

<body>

<div class="card">
    <div class="header">
        <h2>Reset Password</h2>
    </div>

    <div class="body">

        <form method="post" asp-action="ResetPassword" asp-controller="User" id="resetForm">

            <input type="password"
                   name="password"
                   id="password"
                   class="input"
                   placeholder="New Password"
                   required />

            <input type="password"
                   name="confirmPassword"
                   id="confirmPassword"
                   class="input"
                   placeholder="Confirm Password"
                   required />

            <div id="errorMsg" class="error"></div>

            <button type="submit" class="btn">
                Reset Password
            </button>

        </form>

    </div>
</div>

<script>
    $("#resetForm").on("submit", function (e) {

        var password = $("#password").val();
        var confirmPassword = $("#confirmPassword").val();

        if (password !== confirmPassword) {
            e.preventDefault();
            $("#errorMsg").text("Passwords do not match");
            return;
        }

        if (password.length < 6) {
            e.preventDefault();
            $("#errorMsg").text("Password must be at least 6 characters");
            return;
        }

        $("#errorMsg").text("");
    });
</script>

</body>
</html>