@using Repository.Models
@using Repository.Models.Enums
@using System.Text.Json

@{
    ViewData["Title"] = "Admin Dashboard";

    var allQueries      = (ViewBag.AllQueries      as List<AdminQuery>) ?? new List<AdminQuery>();
    var solvedQueries   = (ViewBag.SolvedQueries   as List<AdminQuery>) ?? new List<AdminQuery>();
    var openQueries     = (ViewBag.OpenQueries     as List<AdminQuery>) ?? new List<AdminQuery>();
    var progressQueries = (ViewBag.ProgressQueries as List<AdminQuery>) ?? new List<AdminQuery>();
    var empPerformance  = (ViewBag.EmpPerformance  as IEnumerable<dynamic>) ?? new List<dynamic>();
    var users           = ViewBag.Users as List<Repository.Models.User> ?? new List<Repository.Models.User>();

    int total        = allQueries.Count;
    int solved       = solvedQueries.Count;
    int pending      = progressQueries.Count;
    int todayTotal   = ViewBag.TodayTotal   ?? 0;
    int todaySolved  = ViewBag.TodaySolved  ?? 0;
    int todayOpen    = ViewBag.TodayOpen    ?? 0;
    int todayPending = ViewBag.TodayPending ?? 0;

  // ... existing ViewBag variables ...
    var notifications = (ViewBag.Notifications as List<string>) ?? new List<string>();
    long notificationCount = ViewBag.Count ?? 0L;



    // ── include empId so assigned dropdown survives refresh ──
    var chartData = allQueries.Select(q => new {
        queryId     = q.QueryId,
        title       = q.Title       ?? "",
        companyName = q.Username    ?? "",
        priority    = q.Priority.ToString(),
        status      = q.Status.ToString(),
        queryDate   = q.QueryDate,
        empId       = q.EmpId ?? 0,
        assignedTo  = q.EmployeeName ?? "",
        comments    = q.Comments    ?? ""
    }).ToList();

    var usersJson = users.Select(u => new {
        userId      = u.UserId,
        companyName = u.CompanyName ?? "",
        email       = u.Email       ?? ""
    }).ToList();
}

