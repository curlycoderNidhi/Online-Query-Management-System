<!-- 🔥 SMOOTH DASHBOARD CSS - PERFECT FOR KENDO -->
<style>

    .dashboard-appbar{
    background: linear-gradient(to right, #b39fff, #4300af); /* Blue → Purple */
    padding: 12px 20px;
    border-radius: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dashboard-logout-wrap {
    margin-left: auto;
}

.dashboard-logout-btn {
    background: #ffffff !important;
    color: #1f2937 !important;
    border: 1px solid #d1d5db !important;
    font-weight: 600 !important;
}
/* Smooth Modern Dashboard */
:root {
    --bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --card-bg: rgba(255, 255, 255, 0.95);
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    --shadow-hover: 0 20px 40px rgba(0, 0, 0, 0.15);
    --primary: #3b82f6;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
}

body {
    background: var(--bg-gradient);
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    padding-top: 80px;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1030;
}

/* 🔥 PERFECT HEADER */
.dashboard-header {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border-radius: 0 0 24px 24px;
    box-shadow: var(--shadow);
    padding: 2rem;
    margin-bottom: 2rem;
}

.header-title {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary), #1d4ed8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
}

/* 🔥 STATS CARDS - SMOOTH */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
}

.stat-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: var(--shadow);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), #60a5fa);
    transform: scaleX(0);
    transition: transform 0.4s ease;
}

.stat-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
}

.stat-card:hover::before {
    transform: scaleX(1);
}

.stat-icon {
    font-size: 3rem;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

.stat-primary .stat-icon { background: linear-gradient(135deg, var(--primary), #60a5fa); color: white; }
.stat-success .stat-icon { background: linear-gradient(135deg, var(--success), #34d399); color: white; }
.stat-warning .stat-icon { background: linear-gradient(135deg, var(--warning), #fbbf24); color: white; }
.stat-info .stat-icon { background: linear-gradient(135deg, #06b6d4, #0ea5e9); color: white; }

.stat-number {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1;
}

.stat-primary .stat-number { color: var(--primary); }
.stat-success .stat-number { color: var(--success); }
.stat-warning .stat-number { color: var(--warning); }
.stat-info .stat-number { color: #06b6d4; }

.stat-label {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
}

/* 🔥 GRID CONTAINER */
.grid-container {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* 🔥 KENDO GRID ENHANCEMENTS */
#queryGrid {
    border-radius: 20px !important;
    overflow: hidden !important;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
}

.k-grid-header {
    background: linear-gradient(135deg, var(--primary), #1d4ed8) !important;
    color: white !important;
}

.k-grid-header th {
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    padding: 1.2rem 1rem !important;
}

.k-grid tr:hover td {
    background: rgba(59, 130, 246, 0.08) !important;
}

/* 🔥 ASSIGN CONTROLS - SMOOTH */
.assign-wrap {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px !important;
    background: rgba(255, 255, 255, 0.8) !important;
    border-radius: 16px !important;
    transition: all 0.3s ease !important;
}

.assign-wrap:hover {
    background: rgba(255, 255, 255, 1) !important;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1) !important;
}

.assign-select {
    flex: 1 !important;
    padding: 10px 14px !important;
    border: 2px solid rgba(59, 130, 246, 0.2) !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
    background: white !important;
    transition: all 0.3s ease !important;
}

.assign-select:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
}

.assign-btn {
    padding: 10px 18px !important;
    border-radius: 12px !important;
    background: linear-gradient(135deg, var(--primary), #1d4ed8) !important;
    color: white !important;
    border: none !important;
    font-weight: 700 !important;
    font-size: 0.85rem !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
}

.assign-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4) !important;
}

/* 🔥 BADGES - SMOOTH */
.badge {
    padding: 6px 14px !important;
    border-radius: 20px !important;
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
}

.badge-open { 
    background: linear-gradient(135deg, #fef3c7, #fde68a) !important;
    color: #92400e !important;
    border: 1px solid #fcd34d !important;
}

.badge-progress { 
    background: linear-gradient(135deg, #dbeafe, #bfdbfe) !important;
    color: #1e40af !important;
    border: 1px solid #93c5fd !important;
}

.badge-solved { 
    background: linear-gradient(135deg, #d1fae5, #a7f3d0) !important;
    color: #065f46 !important;
    border: 1px solid #86efac !important;
}

.pri-high { color: var(--danger) !important; font-weight: 900 !important; }
.pri-medium { color: var(--warning) !important; font-weight: 700 !important; }
.pri-low { color: var(--success) !important; font-weight: 700 !important; }

/* 🔥 NOTIFICATION */
#notification {
    position: fixed !important;
    bottom: 2rem !important;
    right: 2rem !important;
    z-index: 9999 !important;
}
</style>

