@using Repository.Models
@using Repository.Models.Enums
@using System.Text.Json
@using System.Linq

@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";

    
    var allQueries = (ViewBag.AllQueries as List<AdminQuery>) ?? new List<AdminQuery>();
    var solvedQueries = (ViewBag.SolvedQueries as List<AdminQuery>) ?? new List<AdminQuery>();
    var openQueries = (ViewBag.OpenQueries as List<AdminQuery>) ?? new List<AdminQuery>();
    var progressQueries = (ViewBag.ProgressQueries as List<AdminQuery>) ?? new List<AdminQuery>();
    var empPerformance = (ViewBag.EmpPerformance as List<EmployeePerformance>) ?? new List<EmployeePerformance>();
    
    var employees = ViewBag.Employees as List<Employee> ?? new List<Employee>();

    var cardsSafe = new Dictionary<string, int>();
    var cardsRaw = ViewBag.Cards;
    
    if (cardsRaw != null)
    {
        if (cardsRaw is Dictionary<string, int> intDict) { cardsSafe = intDict; }
        else if (cardsRaw is Dictionary<string, object> objDict)
        {
            foreach (var kvp in objDict) { cardsSafe[kvp.Key] = SafeInt(kvp.Value); }
        }
        else if (cardsRaw is Dictionary<string, string> strDict)
        {
            foreach (var kvp in strDict) { cardsSafe[kvp.Key] = SafeInt(kvp.Value); }
        }
    }

    int totalQueries = cardsSafe.GetValueOrDefault("TotalQueries", 0);
    int todayQueries = cardsSafe.GetValueOrDefault("TodayQueries", 0);
    int solvedAll = cardsSafe.GetValueOrDefault("SolvedQueries", 0);
    int solvedToday = cardsSafe.GetValueOrDefault("SolvedToday", 0);
    int openAll = cardsSafe.GetValueOrDefault("OpenQueries", 0);
    int progressAll = cardsSafe.GetValueOrDefault("InProgressQueries", 0);
    int pendingAll = cardsSafe.GetValueOrDefault("PendingQueries", openAll + progressAll);
    int pendingToday = cardsSafe.GetValueOrDefault("PendingToday", 0);

    @functions {
        int SafeInt(object value) => value switch
        {
            int i => i, long l => (int)l,
            string s => int.TryParse(s, out int p) ? p : 0,
            _ => 0
        };
    }

    string PriorityLabel(Priority p) => p switch { Priority.High => "High", Priority.Medium => "Medium", _ => "Low" };
    string StatusLabel(QueryStatus s) => s switch { QueryStatus.Solved => "Solved", QueryStatus.InProgress => "In Progress", _ => "Open" };

    var empOnly = empPerformance
        .Where(e => !string.Equals(e.EmployeeName, "Admin", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(e.EmployeeName, "admin", StringComparison.OrdinalIgnoreCase))
        .ToList();

    int maxResolved = empOnly.Any() ? empOnly.Max(e => e.ResolvedQueries) : 1;
    if (maxResolved == 0) maxResolved = 1;

    var allJson = allQueries.Select(q => new {
        queryId = q.QueryId, username = q.Username ?? "", title = q.Title ?? "",
        priorityLabel = PriorityLabel(q.Priority), statusLabel = StatusLabel(q.Status),
        employeeName = q.EmployeeName ?? "", comments = q.Comments ?? ""
    });
    var assignableEmployees = employees
        .Where(e => !string.Equals(e.EmpName, "Admin", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

