<!-- 🔥 YOUR KENDO CODE - 100% UNCHANGED -->
@section Scripts {
<script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>
<script>
    var allData = @Html.Raw(JsonSerializer.Serialize(allJson, jsonOpts));
    var employeeList = [
        { empId: 0, empName: "— Unassign —" },
        @foreach (var emp in assignableEmployees) { <text>{ empId: @emp.EmpId, empName: "@emp.EmpName" },</text> }
    ];

    $(document).ready(function () {
        var notification = $("#notification").kendoNotification({
            position: { bottom: 24, right: 24 }, autoHideAfter: 3500
        }).data("kendoNotification");

        var statusTpl = "# var sc = statusLabel==='Solved'?'badge-solved':statusLabel==='In Progress'?'badge-progress':'badge-open'; #<span class='badge #= sc #'>#= statusLabel #</span>";
        var priorityTpl = "# var pc = priorityLabel==='High'?'pri-high':priorityLabel==='Medium'?'pri-medium':'pri-low'; #<span class='#= pc #'>#= priorityLabel #</span>";

        function assignTemplate(dataItem) {
            var opts = employeeList.map(function(e) {
                var sel = (dataItem.employeeName && e.empName === dataItem.employeeName) ? ' selected' : '';
                return '<option value="' + e.empId + '"' + sel + '>' + kendo.htmlEncode(e.empName) + '</option>';
            }).join('');
            return '<div class="assign-wrap">' +
                '<select class="assign-select" data-queryid="' + dataItem.queryId + '">' + opts + '</select>' +
                '<button class="assign-btn k-button" onclick="doAssign(' + dataItem.queryId + ', this)">Assign</button>' +
                '</div>';
        }

        // Main Query Grid - Full Width
        $("#queryGrid").kendoGrid({
            dataSource: { data: allData, pageSize: 12, sort: { field: "queryId", dir: "desc" } },
            pageable: { pageSizes: [12, 24, 50, "all"] },
            sortable: true, 
            scrollable: true,
            height: 700,
            toolbar: [{ template: '<span style="font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;color:Black(255,255,255,0.9);padding:8px 12px;font-weight:700;background:rgba(255,255,255,0.2);border-radius:8px;">All Queries - Live Management</span>' }],
            columns: [
                { field: "queryId", title: "ID", width: 70 },
                { field: "username", title: "Company", width: 180 },
                { field: "title", title: "Title", width: 280 },
                { field: "priorityLabel", title: "Priority", width: 120, template: priorityTpl },
                { field: "statusLabel", title: "Status", width: 140, template: statusTpl },
                { field: "employeeName", title: "Assigned To", width: 150 },
                { field: "comments", title: "Comments", width: 200 },
                { title: "Actions", width: 260, template: assignTemplate }
            ]
        });

        // Elite Hover Effects
        $(".stat-card").hover(
            function() { 
                $(this).css({ 
                    transform: "translateY(-8px)",
                    boxShadow: "0 20px 40px rgba(0,0,0,0.15)"
                }); 
            },
            function() { 
                $(this).css({ 
                    transform: "translateY(0)", 
                    boxShadow: "0 10px 30px rgba(0,0,0,0.1)"
                }); 
            }
        );

        notification.show("Admin Dashboard loaded successfully!", "success");
    });

    function doAssign(queryId, btn) {
        var select = $(btn).closest('.assign-wrap').find('.assign-select');
        var empId = parseInt(select.val());
        var empName = select.find('option:selected').text();
        var notification = $("#notification").data("kendoNotification");

        $.post('/Admin/AssignEmployee', { queryId: queryId, empId: empId })
            .done(function(res) {
                if (res && res.success === false) {
                    notification.show(res.message || "Assignment failed.", "error");
                    return;
                }
                notification.show(
                    empId === 0 ? "Employee unassigned." : empName + " assigned successfully.",
                    "success"
                );
                var grid = $("#queryGrid").data("kendoGrid");
                var item = grid.dataSource.get(queryId);
                if (item) item.set("employeeName", empId === 0 ? "" : empName);
            })
            .fail(function() {
                notification.show("Request failed.", "error");
            });
    }
</script>
}
