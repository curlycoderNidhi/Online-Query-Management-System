                { field: "companyName", title: "Company",  width: 150 },
                { field: "priority",    title: "Priority", width: 100, template: priTpl },
                { field: "status",      title: "Status",   width: 130, template: staTpl },
                { field: "queryDate",   title: "Date",     width: 110,
                  template: function(d) {
                      var dt = new Date(d.queryDate);
                      return isNaN(dt.getTime()) ? "" : kendo.toString(dt, "yyyy-MM-dd");
                  }
                },
                { field: "comments",   title: "Comments", width: 180,
                  template: function(d) {
                      if (!d.comments) return "<span class='text-muted'>—</span>";
                      var t = d.comments.length > 45 ? d.comments.substring(0, 45) + "…" : d.comments;
                      return "<span title='" + kendo.htmlEncode(d.comments) + "'>" + kendo.htmlEncode(t) + "</span>";
                  }
                },
                { field: "assignedTo", title: "Assign To", width: 240,
                  filterable: false, sortable: false,
                  template: function(d) {
                      var val      = (d.empId || 0).toString();
                      var status   = (d.status || "").toString().toLowerCase();
                      var isSolved = status === "solved";
                      // Button is enabled only when nothing is yet assigned and query is not solved
                      var canAssign = !isSolved && val === "0";
                      return "<div class='assign-container'>" +
                                 "<input class='assign-ddl' data-query='" + d.queryId +
                                        "' data-current='" + val +
                                        "' data-status='" + d.status + "' />" +
                                 "<button type='button' class='btn btn-sm btn-outline-primary assign-btn'" +
                                         " data-query='" + d.queryId + "'" +
                                         (canAssign ? "" : " disabled") + ">Assign</button>" +
                             "</div>";
                  }
                }
            ]
        });

        /* ── Users Grid ── */
        $("#usersGrid").kendoGrid({
            dataSource: { data: usersData, pageSize: 10 },
            pageable:   { pageSizes: [10, 25, 50, "all"] },
            sortable:   true,
            filterable: true,
            scrollable: false,
            columns: [
                { field: "userId",      title: "ID",           width: 80 },
                { field: "companyName", title: "Company Name", width: 280 },
                { field: "email",       title: "Email",        minWidth: 200 }
            ]
        });

        /* ── Search bar logic ── */
        /* ══════════════════════════════════════════════════════
   ELASTICSEARCH-BACKED SEARCH BAR
══════════════════════════════════════════════════════ */

var searchTimer   = null;
var activeRequest = null;

function setSearchBusy(busy) {
    $("#applyFilterBtn").prop("disabled", busy).html(
        busy ? '<span class="spinner-border spinner-border-sm me-1"></span>Searching…'
             : '<i class="bi bi-funnel-fill"></i> Filter'
    );
}

function updateSearchStatus(count) {
    $("#searchStatus").text(count === null ? "" : count + " result" + (count !== 1 ? "s" : ""));
}

function runElasticSearch() {
    var q        = $("#querySearch").val().trim();
    var status   = $("#filterStatus").val();
    var fromDate = $("#fromDate").val();
    var toDate   = $("#toDate").val();

    if (!q && !status && !fromDate && !toDate) {
        queryDS.data(recent);
        updateSearchStatus(null);
        $("#searchClear").hide();
        setSearchBusy(false);
        return;
    }

    if (activeRequest) { activeRequest.abort(); activeRequest = null; }

    setSearchBusy(true);
    $("#searchStatus").text("Searching…");

    var params = {};
    if (q)        params.q        = q;
    if (status)   params.status   = status;
    if (fromDate) params.fromDate = fromDate;
    if (toDate)   params.toDate   = toDate;

    activeRequest = $.get("/Admin/SearchQueries", params)
        .done(function (results) {
            activeRequest = null;

            if (results && results.error) {
                notification.show("Search error: " + results.error, "error");
                setSearchBusy(false);
                updateSearchStatus(null);
                return;
            }

            var mapped = (results || []).map(function(r) {
                return {
                    queryId:     r.queryId,
                    title:       r.title       || "",
                    companyName: r.companyName || "",
                    priority:    r.priority    || "",
                    status:      r.status      || "",
                    queryDate:   r.queryDate   ? new Date(r.queryDate) : new Date(),
                    empId:       r.empId       || 0,
                    assignedTo:  r.assignedTo  || "Unassigned",
                    comments:    r.comments    || ""
                };
            });

            queryDS.data(mapped);
            updateSearchStatus(mapped.length);
            setSearchBusy(false);
        })
        .fail(function (xhr) {
            activeRequest = null;
            if (xhr.statusText === "abort") return;
            notification.show("Search request failed.", "error");
            setSearchBusy(false);
            updateSearchStatus(null);
        });
}

$("#querySearch").on("input", function () {
    clearTimeout(searchTimer);
    $("#searchClear").toggle($(this).val().trim().length > 0);
    searchTimer = setTimeout(runElasticSearch, 300);
});

$("#searchClear").on("click", function () {
    $("#querySearch").val("").trigger("input");
});

$("#applyFilterBtn")
    .hover(
        function() { $(this).css("background", "#1d4ed8"); },
        function() { $(this).css("background", "#2563eb"); })
    .on("click", function () {
        clearTimeout(searchTimer);
        runElasticSearch();
    });

$("#resetFilterBtn")
    .hover(
        function() { $(this).css("background", "#f1f5f9"); },
        function() { $(this).css("background", "#f8fafc"); })
    .on("click", function () {
        clearTimeout(searchTimer);
        if (activeRequest) { activeRequest.abort(); activeRequest = null; }
        $("#querySearch").val("");
        $("#filterStatus").val("");
        $("#fromDate").val("");
        $("#toDate").val("");
        $("#searchClear").hide();
        updateSearchStatus(null);
        setSearchBusy(false);
        queryDS.data(recent);
    });

$("#filterStatus, #fromDate, #toDate").on("focus", function() {
    $(this).css({ "border-color": "#3b82f6", "box-shadow": "0 0 0 3px rgba(59,130,246,0.12)", "background": "#fff" });
}).on("blur", function() {
    $(this).css({ "border-color": "#e2e8f0", "box-shadow": "none", "background": "#f8fafc" });
});

/* ══════════════════════════════════════════════════════ */

        notification.show("Dashboard loaded successfully!", "success");
    });

    /* ── Assign dropdowns ──────────────────────────────────── */
/* ── Assign dropdowns ──────────────────────────────────── */
/* ── Assign dropdowns ──────────────────────────────────── */
// Track assigned queries locally so dataBound skips them
var assignedMap = {};

// Pre-populate from existing data
recent.forEach(function(q) {
    if (q.empId && q.empId !== 0) {
        assignedMap[q.queryId] = true;
    }
});

function initAssignDropdowns() {
    this.tbody.find(".assign-container").each(function () {
        var $container = $(this);
        var $input     = $container.find("input.assign-ddl");
        var $button    = $container.find("button.assign-btn");
        var queryId    = parseInt($input.data("query"), 10);
        var status     = ($input.data("status") || "").toString().toLowerCase().replace(/\s+/g, "");
        var isSolved   = status === "solved";
        var initial    = ($input.data("current") || "0").toString();

        // Check our local map — if assigned after page load, use that
        var assigned = assignedMap[queryId] === true || initial !== "0";

        var dropdown = $input.kendoDropDownList({
            dataSource:    employees,
            dataTextField:  "text",
            dataValueField: "value",
            value: assigned ? initial : "0",
            optionLabel: "Select employee"
        }).data("kendoDropDownList");

        var refreshButtonState = function () {
            var selection = dropdown.value() || "0";
            var enable    = !assigned && !isSolved && selection !== "0";
            $button.prop("disabled", !enable);
        };

        dropdown.enable(!assigned && !isSolved);
        dropdown.bind("change", refreshButtonState);

        // If assigned from our map, lock the button text too
        // Lock button text for all assigned rows (from DB or from this session)
        if (assigned) {
            $button.text("Assigned").prop("disabled", true);
        } else if (isSolved) {
            $button.text("Assign").prop("disabled", true);
        } else {
            refreshButtonState();
        }

        $button.off("click").on("click", function () {
            if ($button.prop("disabled") || assigned || isSolved) return;

            var newEmpId = parseInt(dropdown.value() || "0", 10);
            if (!newEmpId) return;

            $button.prop("disabled", true).text("Assigning…");

            $.post("/Admin/AssignEmployee", { queryId: queryId, empId: newEmpId })
                .done(function (res) {
                    if (res && res.success === false) {
                        $("#notification").data("kendoNotification")
                            .show(res.message || "Assignment failed.", "error");
                        $button.prop("disabled", false).text("Assign");
                        return;
                    }

                    var empName = employeeLookup[newEmpId] || "Unassigned";

                    // ── Mark as assigned in our local map ──
                    assignedMap[queryId] = true;
                    assigned = true;

                    // ── Lock controls ──
                    dropdown.enable(false);
                    $button.text("Assigned").prop("disabled", true);

                    // ── Update status badge via DOM ──
                    var row = $button.closest("tr");
                    if (row.length) {
                        var statusCell = row.find("td").eq(4);
                        var curText    = statusCell.find(".b").text().trim().toLowerCase();
                        if (curText === "open") {
                            statusCell.html("<span class='b b-blue'>In Progress</span>");
                        }
                    }

                    $("#notification").data("kendoNotification")
                        .show(empName + " assigned successfully.", "success");
                })
                .fail(function () {
                    $button.prop("disabled", false).text("Assign");
                    $("#notification").data("kendoNotification")
                        .show("Request failed.", "error");
                });
        });
    });
}
</script>
