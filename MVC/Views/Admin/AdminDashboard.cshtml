}
    .dash-page { padding: 1.75rem 1.5rem 3rem; }

   .dash-page { padding: 1.75rem 1.5rem 3rem; }

    /* ── Page heading ─────────────────────────────────── */
    .dash-heading {
        display: flex; align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 1.75rem; gap: 1rem;
    }
    .dash-heading-left h4 {
        font-size: 1.35rem; font-weight: 700;
        color: #0f172a; margin-bottom: 0; letter-spacing: -0.2px;
    }
    .dash-heading-left p { font-size: 0.82rem; color: #64748b; margin: 0; }
    .dash-heading-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }

    /* ── Stat cards ───────────────────────────────────── */
    .stat-card {
        background: #fff; border-radius: 16px;
        padding: 1.35rem 1.4rem 1.2rem;
        border: 1px solid #e8edf3;
        box-shadow: 0 1px 4px rgba(15,23,42,0.05);
        transition: box-shadow 0.2s, transform 0.2s;
        position: relative; overflow: hidden;
    }
    .stat-card:hover { box-shadow: 0 6px 20px rgba(15,23,42,0.1); transform: translateY(-2px); }
    .stat-card::after {
        content: ''; position: absolute; top: 0; left: 0; right: 0;
        height: 4px; border-radius: 16px 16px 0 0;
    }
    .stat-card.c-blue::after  { background: linear-gradient(90deg,#3b82f6,#6366f1); }
    .stat-card.c-green::after { background: linear-gradient(90deg,#10b981,#34d399); }
    .stat-card.c-red::after   { background: linear-gradient(90deg,#f43f5e,#fb923c); }
    .stat-card.c-cyan::after  { background: linear-gradient(90deg,#06b6d4,#3b82f6); }

    .stat-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.9rem; }
    .stat-icon {
        width: 42px; height: 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
    }
    .c-blue  .stat-icon { background: #eff6ff; color: #3b82f6; }
    .c-green .stat-icon { background: #ecfdf5; color: #10b981; }
    .c-red   .stat-icon { background: #fff1f2; color: #f43f5e; }
    .c-cyan  .stat-icon { background: #ecfeff; color: #06b6d4; }

    .stat-label {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.7px; color: #94a3b8; margin-bottom: 0.3rem;
    }
    .stat-value { font-size: 2.2rem; font-weight: 800; line-height: 1; color: #0f172a; }
    .stat-footer {
        margin-top: 0.9rem; padding-top: 0.75rem;
        border-top: 1px solid #f1f5f9;
        display: flex; align-items: center; justify-content: space-between;
    }
    .stat-footer-label { font-size: 0.75rem; color: #94a3b8; }
