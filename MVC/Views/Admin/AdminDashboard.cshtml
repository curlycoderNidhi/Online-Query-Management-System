@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
 // Notification System
    let notifications = @Html.Raw(JsonSerializer.Serialize(notifications));
    let notificationCount = @notificationCount;

    function escHtml(s) {
        return String(s ?? "")
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function loadNotifications() {
        const count = notificationCount;

        document.getElementById('notificationCount').textContent = count > 99 ? '99+' : count;
        document.getElementById('totalNotifications').textContent = count;
        document.getElementById('notificationBadge').style.display = count > 0 ? 'block' : 'none';

        renderNotificationList();
    }

    function renderNotificationList() {
        const list = document.getElementById('notificationList');

        if (!notifications || notifications.length === 0) {
            list.innerHTML = `
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-bell-slash fs-1 mb-2 opacity-50"></i>
                    <p class="mb-0">No notifications</p>
                </div>
            `;
            return;
        }

        list.innerHTML = notifications.map((n, index) => `
            <div class="dropdown-item p-3 notification-item unread" data-id="${index}">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-bell text-primary fs-6"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold text-dark">Notification</div>
                        <div class="small text-muted">${escHtml(n)}</div>
                    </div>
                </div>
            </div>
        `).join('');
    }
    
    function playBellSound() {
        try {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (!AudioContextClass) return;
            const audioCtx = new AudioContextClass();
            const masterGain = audioCtx.createGain();
            masterGain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
            masterGain.gain.exponentialRampToValueAtTime(0.32, audioCtx.currentTime + 0.02);
            masterGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.6);
            masterGain.connect(audioCtx.destination);

            const tones = [
                { freq: 1320.00, type: 'triangle', start: 0.00, stop: 0.22, gain: 1.00 },
                { freq: 1661.22, type: 'sine',     start: 0.00, stop: 0.22, gain: 0.42 },
                { freq: 1320.00, type: 'triangle', start: 0.32, stop: 0.54, gain: 1.00 },
                { freq: 1661.22, type: 'sine',     start: 0.32, stop: 0.54, gain: 0.42 },
                { freq: 1481.66, type: 'triangle', start: 0.86, stop: 1.12, gain: 0.92 },
                { freq: 1977.77, type: 'sine',     start: 0.86, stop: 1.12, gain: 0.35 }
            ];

            tones.forEach(function(t) {
                const oscillator = audioCtx.createOscillator();
                const toneGain = audioCtx.createGain();
                oscillator.type = t.type;
                oscillator.frequency.setValueAtTime(t.freq, audioCtx.currentTime + t.start);
                oscillator.frequency.exponentialRampToValueAtTime(t.freq * 0.998, audioCtx.currentTime + t.stop);
                toneGain.gain.setValueAtTime(0.0001, audioCtx.currentTime + t.start);
                toneGain.gain.exponentialRampToValueAtTime(0.24 * t.gain, audioCtx.currentTime + t.start + 0.02);
                toneGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + t.stop);
                oscillator.connect(toneGain);
                toneGain.connect(masterGain);
                oscillator.start(audioCtx.currentTime + t.start);
                oscillator.stop(audioCtx.currentTime + t.stop);
            });

            setTimeout(function() { audioCtx.close(); }, 1700);
        } catch (e) { }
    }

