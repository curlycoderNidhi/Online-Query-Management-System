                visible: true,
                background: "#0f172a",
                color: "#fff",
                template: "#= category #: #= value # queries (#= kendo.toString(percentage,'p0') #)"
            }
        });
          /* ── Employee bar chart (horizontal) ── */
        var empSortAsc = false; // default: highest first (descending)

        function getSortedEmpStats() {
            return empStats.slice().sort(function(a, b) {
                return empSortAsc
                    ? a.totalCount - b.totalCount   // lowest first
                    : b.totalCount - a.totalCount;  // highest first
            });
        }

        function buildEmpChart() {
            var sorted = getSortedEmpStats();
            var chart  = $("#empChart").data("kendoChart");

            var options = {
                dataSource: { data: sorted },
                chartArea:  { background: "transparent" },
                series: [
                    { type: "column", field: "totalCount", name: "Total Assigned", color: "#93c5fd", border: { width: 0 } },
                    { type: "column", field: "solvedCount", name: "Solved",        color: "#2563eb", border: { width: 0 } }
                ],
                categoryAxis: {
                    field: "empName",
                    labels: { font: "600 12px 'Segoe UI'", color: "#374151" },
                    majorGridLines: { visible: false }
                },
                valueAxis: {
                    title: { text: "Queries", font: "12px 'Segoe UI'", color: "#94a3b8" },
                    min: 0,
                    labels: { font: "12px 'Segoe UI'", color: "#94a3b8" },
                    majorGridLines: { color: "#f1f5f9" }
                },
                legend: { visible: false },
                tooltip: {
                    visible: true, background: "#0f172a", color: "#fff",
