<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Query Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.default.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
@{
    var role = Context.Session.GetString("Role");
    var userName = role == "user"
        ? Context.Session.GetString("CompanyName")
        : Context.Session.GetString("empname");
}

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="bi bi-headset me-2"></i>QMS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (role == "user")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Dashboard">
                            <i class="bi bi-list-ul me-1"></i>My Queries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="CreateQuery">
                            <i class="bi bi-plus-circle me-1"></i>New Query
                        </a>
                    </li>
                }
                @if (role == "employee")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employee" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employee" asp-action="MyQueries">
                            <i class="bi bi-ticket-perforated me-1"></i>My Queries
                        </a>
                    </li>
                }
                @if (role == "admin")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="AdminDashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Admin Dashboard
                        </a>
                    </li>
                }
                @if (string.IsNullOrEmpty(role))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Login">User Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employee" asp-action="Login">Employee Login</a>
                    </li>
                }
            </ul>

            @if (!string.IsNullOrEmpty(role))
            {
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@(string.IsNullOrEmpty(userName) ? "Account" : userName)
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (role == "user")
                            {
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="User" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <form asp-controller="Employee" asp-action="Logout" method="post" class="px-3">
                                        <button type="submit" class="btn btn-link dropdown-item text-danger p-0">
                                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

<main class="flex-fill py-4">
    <div class="container-fluid px-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>
</main>

<footer class="bg-light border-top py-3 text-center text-muted small mt-auto">
    &copy; @DateTime.Now.Year Query Management System
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
