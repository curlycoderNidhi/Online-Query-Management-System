@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Online Query Management</h1>

    @if (Context.Session.GetString("empid") is null)
    {
        <p class="mt-3">Please login to manage employee queries.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Login">Employee Login</a>
    }
    else
    {
        <p class="mt-3">You are logged in. Go to your dashboard.</p>
        <a class="btn btn-primary" asp-controller="Employee" asp-action="Dashboard">Open Dashboard</a>
    }
</div>
