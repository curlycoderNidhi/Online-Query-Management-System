@{
    Layout = null;
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Query Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.2), transparent 25%),
                        radial-gradient(circle at 80% 0%, rgba(255,255,255,0.12), transparent 25%),
                        linear-gradient(135deg, #0a68ff 0%, #0454d4 60%, #0a68ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-card {
            width: 440px;
            max-width: 95vw;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.18);
            padding: 28px 32px 32px;
        }
        .login-card .icon {
            font-size: 2.6rem;
            color: #0d6efd;
        }
        .segment-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin: 14px 0 16px;
        }
        .segment-btn {
            border: 1px solid #d9dce0;
            background: #f6f7fb;
            color: #1f2937;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all .2s ease;
        }
        .segment-btn.active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
            box-shadow: 0 10px 25px rgba(13,110,253,.35);
        }
        .form-control, .form-control:focus {
            background: #f5f7fb;
            border: 1px solid #e1e5ec;
            box-shadow: none;
        }
        .btn-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0a5fd3 100%);
            border: none;
            font-weight: 700;
            box-shadow: 0 12px 32px rgba(13,110,253,.35);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #0b5ed7 0%, #0a58ca 100%);
        }
        .alt-link {
            margin-top: 12px;
            font-size: 0.93rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-3">
            <div class="icon mb-2"><i class="bi bi-headset"></i></div>
            <h4 class="fw-bold mb-1">Query Management</h4>
            <div class="text-muted">Sign in to continue</div>
        </div>

        <div class="segment-buttons">
            <button type="button" class="segment-btn active" id="userTab" onclick="setMode('user')">
                <i class="bi bi-person"></i> User
            </button>
            <button type="button" class="segment-btn" id="empTab" onclick="setMode('employee')">
                <i class="bi bi-shield-lock"></i> Employee / Admin
            </button>
        </div>

        <form id="authForm" method="post" action="/User/Login">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modeInput" value="user" />

            <div class="mb-3">
                <label class="form-label fw-semibold" id="labelUser">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input class="form-control" id="userField" name="Email" type="email" placeholder="Enter email" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input class="form-control" id="passField" name="Password" type="password" placeholder="Enter password" required minlength="6" />
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePwd()" style="border-left:none;border-radius:0 10px 10px 0;">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </button>
        </form>

        <div class="text-center alt-link" id="signupLine">
            Don't have an account? <a class="fw-semibold" href="/User/Register">Sign up</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setMode(mode) {
            const userBtn = document.getElementById('userTab');
            const empBtn = document.getElementById('empTab');
            const label = document.getElementById('labelUser');
            const field = document.getElementById('userField');
            const form = document.getElementById('authForm');
            const signupLine = document.getElementById('signupLine');
            document.getElementById('modeInput').value = mode;

            if (mode === 'user') {
                userBtn.classList.add('active');
                empBtn.classList.remove('active');
                label.textContent = 'Email Address';
                field.type = 'email';
                field.name = 'Email';
                field.placeholder = 'Enter email';
                form.action = '/User/Login';
                signupLine.style.display = 'block';
            } else {
                empBtn.classList.add('active');
                userBtn.classList.remove('active');
                label.textContent = 'Username';
                field.type = 'text';
                field.name = 'EmpName';
                field.placeholder = 'Enter username';
                form.action = '/Employee/Login';
                signupLine.style.display = 'none';
            }
        }

        function togglePwd() {
            const pwd = document.getElementById('passField');
            const icon = document.getElementById('eyeIcon');
            if (pwd.type === 'password') { pwd.type = 'text'; icon.className = 'bi bi-eye-slash'; }
            else { pwd.type = 'password'; icon.className = 'bi bi-eye'; }
        }
    </script>
</body>
</html>
