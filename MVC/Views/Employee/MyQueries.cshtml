@{
    ViewData["Title"] = "My Queries";
}

<style>
/* ===========================================
   ELITE KENDO UI "MY QUERIES" - ENHANCED
============================================= */

.myq-wrap {
    margin-top: 1rem;
    padding: 1.75rem;
    border-radius: 20px;
    background: linear-gradient(135deg, #fffaf1 0%, #f5fbff 100%);
    border: 1px solid rgba(230, 230, 214, 0.6);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
}

.myq-panel {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(230, 237, 245, 0.8);
    border-radius: 18px;
    box-shadow: 0 16px 48px rgba(15, 23, 42, 0.12);
    padding: 1.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.myq-panel:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.16);
}

/* Premium Header */
.myq-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid rgba(59, 130, 246, 0.12);
}

.myq-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #3B82F6, #1D4ED8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
}

/* Elite Stats Chips */
.myq-stats {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
}

.myq-chip {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    border: 2px solid rgba(223, 229, 239, 0.6);
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
    color: #334155;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.625rem 1.125rem;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(12px);
}

.myq-chip:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.15);
}

/* ENHANCED Kendo Grid */
#grid {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.12);
    border: none !important;
}

#grid .k-grid-header {
    background: linear-gradient(90deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 4px solid #3B82F6 !important;
    position: sticky;
    top: 0;
    z-index: 10;
}

#grid .k-grid-header .k-table-th {
    padding: 1.25rem 1rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    font-size: 0.85rem !important;
    color: #1e293b !important;
    border: none !important;
    background: linear-gradient(90deg, rgba(255,255,255,0.95), rgba(248,250,252,0.85)) !important;
    box-shadow: inset 0 -1px 0 rgba(226,232,240,0.8);
}

#grid .k-grid-content {
    background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
}

#grid .k-grid-content tr {
    height: 68px !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    border-bottom: 1px solid rgba(226, 232, 240, 0.7) !important;
}

#grid .k-grid-content tr:hover {
    background: linear-gradient(90deg, rgba(59,130,246,0.1), rgba(16,185,129,0.08)) !important;
    transform: translateX(8px) !important;
    box-shadow: 0 12px 36px rgba(59,130,246,0.2) !important;
}

#grid .k-grid-content .k-table-td {
    padding: 1rem 1rem !important;
    vertical-align: middle !important;
}

#grid .k-grid-norecords {
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    padding: 40px 0;
    color: #6b7280;
}

/* ELITE Badges */
.myq-badge {
    border-radius: 24px;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.5rem 1.125rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    border: 2px solid rgba(255,255,255,0.6);
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
}

.myq-priority-high { 
    background: linear-gradient(135deg, #fee2e2, #fecaca) !important; 
    color: #dc2626 !important;
    animation: pulse-high 2s infinite;
}


.myq-priority-medium { 
    background: linear-gradient(135deg, #fef3c7, #fde68a) !important; 
    color: #d97706 !important;
}
.myq-priority-low { 
    background: linear-gradient(135deg, #dcfce7, #bbf7d0) !important; 
    color: #15803d !important;
}
.myq-status-open { 
    background: linear-gradient(135deg, #e2e8f0, #f1f5f9) !important; 
    color: #1e293b !important;
}
.myq-status-progress { 
    background: linear-gradient(135deg, #dbeafe, #bfdbfe) !important; 
    color: #1d4ed8 !important;
}
.myq-status-solved { 
    background: linear-gradient(135deg, #dcfce7, #bbf7d0) !important; 
    color: #15803d !important;
}

/* Premium Comments */
.myq-comments {
    color: #4300af!important;
    font-size: 0.9rem !important;
    max-width: 320px;
    display: inline-block;
    padding: 0.75rem 1rem;
    background: #efeaff;
    border-radius: 12px;
    border-left: 4px solid #efeaff;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.04);

}

/* ELITE Action Button */
.k-grid .k-button.k-primary {
    border-radius: 14px !important;
    padding: 0.875rem 1.75rem !important;
    font-weight: 800 !important;
    background: linear-gradient(135deg, #3B82F6, #1D4ED8) !important;
    border: none !important;
    box-shadow: 0 12px 36px rgba(59,130,246,0.4) !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    min-height: 48px;
    font-size: 0.9rem !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.k-grid .k-button.k-primary:hover {
    transform: translateY(-4px) scale(1.05) !important;
    box-shadow: 0 24px 64px rgba(59,130,246,0.5) !important;
}

/* PREMIUM PAGINATION */
#grid .k-pager {
    background: linear-gradient(90deg, rgba(255,255,255,0.95), rgba(248,250,252,0.9)) !important;
    border-top: 3px solid rgba(59,130,246,0.15) !important;
    border-radius: 0 0 18px 18px !important;
    backdrop-filter: blur(16px);
}

#grid .k-pager-wrap {
    padding: 1.25rem 1.75rem !important;
}

/* NO RECORDS */
#grid .k-no-records {
    padding: 6rem 3rem !important;
    text-align: center;
    color: #64748b;
    font-size: 1.1rem;
}

#grid .k-no-records::before {
    content: "📋✨";
    display: block;
    font-size: 4rem;
    margin-bottom: 1.5rem;
    opacity: 0.6;
}

/* BOOTSTRAP MODAL ENHANCEMENT */
.myq-modal-content {
    border: none !important;
    border-radius: 24px !important;
    overflow: hidden !important;
    box-shadow: 0 32px 96px rgba(15,23,42,0.28) !important;
    background: rgba(255,255,255,0.98) !important;
    backdrop-filter: blur(24px) !important;
}

.myq-modal-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
    color: white !important;
    border-bottom: none !important;
    padding: 1.5rem 2rem !important;
    border-radius: 24px 24px 0 0 !important;
}

.myq-modal-body {
    background: linear-gradient(135deg, #f8fbff 0%, #f1f5f9 100%) !important;
    padding: 2rem !important;
    border-radius: 0 0 24px 24px !important;
}
</style>

<div class="myq-wrap">
    <div class="myq-panel">
        <div class="myq-header">
            <h3 class="myq-title">My Queries</h3>
            <div class="myq-stats">
                <span class="myq-chip" style="color:red;">Total: <span id="totalCount">0</span></span>
                <span class="myq-chip" style="color:rgb(178, 178, 1);">In Progress: <span id="progressCount">0</span></span>
                <span class="myq-chip" style="color:green;">Solved: <span id="solvedCount">0</span></span>
            </div>
        </div>
        <div id="grid"></div>
    </div>
</div>

<!-- ENHANCED Bootstrap Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content myq-modal-content">
            <div class="modal-header myq-modal-header">
                <h5 class="modal-title fw-bold">Update Query</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body myq-modal-body" id="updateModalBody">
                <!-- Form loads here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function ensureKendoReady(done) {
    if (window.kendo && window.jQuery && window.jQuery.fn && window.jQuery.fn.kendoGrid) {
        done();
        return;
    }

    var existing = document.getElementById("kendo-fallback-script");
    if (existing) {
        existing.addEventListener("load", done, { once: true });
        return;
    }

    var script = document.createElement("script");
    script.id = "kendo-fallback-script";
    script.src = "https://kendo.cdn.telerik.com/2024.1.130/js/kendo.all.min.js";
    script.onload = done;
    script.onerror = function () {
        alert("Kendo UI failed to load. Please refresh and try again.");
    };
    document.head.appendChild(script);
}

$(function () {
    if (!window.jQuery) {
        alert("jQuery failed to load. Please refresh and try again.");
        return;
    }

    function priorityMeta(value) {
        if (value === 2 || value === "High") return { text: "High", cls: "myq-priority-high" };
        if (value === 1 || value === "Medium") return { text: "Medium", cls: "myq-priority-medium" };
        return { text: "Low", cls: "myq-priority-low" };
    }

    function statusMeta(value) {
        if (value === 2 || value === "Solved") return { text: "Solved", cls: "myq-status-solved" };
        if (value === 1 || value === "InProgress" || value === "In Progress") return { text: "In Progress", cls: "myq-status-progress" };
        return { text: "Open", cls: "myq-status-open" };
    }

    function updateStats(grid) {
        var data = grid.dataSource.data();
        var total = data.length, solved = 0, progress = 0;
        for (var i = 0; i < total; i++) {
            var s = statusMeta(data[i].status).text;
            if (s === "Solved") solved++;
            if (s === "In Progress") progress++;
        }
        $("#totalCount").text(total);
        $("#progressCount").text(progress);
        $("#solvedCount").text(solved);
    }

    ensureKendoReady(function () {
        $("#grid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: "/Employee/GetMyQueries",
                        dataType: "json"
                    }
                },
                pageSize: 10
            },
            height: 580,
            sortable: true,
            filterable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: [5, 10, 20, 50],
                buttonCount: 5
            },
            noRecords: {
                template: "No assigned queries found."
            },
            dataBound: function () {
                updateStats(this);
            },
            columns: [
                { field: "queryId", title: "ID", width: 80 },
                { field: "title", title: "Title", width: 260 },
                {
                    field: "priority",
                    title: "Priority",
                    width: 130,
                    template: function (d) {
                        var m = priorityMeta(d.priority);
                        return `<span class='myq-badge ${m.cls}'>${m.text}</span>`;
                    }
                },
                {
                    field: "status",
                    title: "Status",
                    width: 150,
                    template: function (d) {
                        var m = statusMeta(d.status);
                        return `<span class='myq-badge ${m.cls}'>${m.text}</span>`;
                    }
                },
                {
                    field: "comments",
                    title: "Comments",
                    width: 300,
                    template: function (d) {
                        var c = d.comments || "-";
                        return `<span class='myq-comments' title='${kendo.htmlEncode(c)}'>${kendo.htmlEncode(c)}</span>`;
                    }
                },
                {
                    title: "Action",
                    width: 120,
                    sortable: false,
                    filterable: false,
                    template: "<button class='k-button k-primary' onclick='openUpdate(#=queryId#)'>Update</button>"
                }
            ]
        });
    });
});

// Enhanced Update Modal
function openUpdate(id) {
    kendo.ui.progress($("#grid"), true);
    $.get("/Employee/UpdateQuery", { id: id })
        .done(function (html) {
            $("#updateModalBody").html(html);
            var modal = new bootstrap.Modal(document.getElementById('updateModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();
        })
        .fail(function (xhr) {
            kendo.alert(xhr.responseText || "Failed to open update popup.");
        })
        .always(function() {
            kendo.ui.progress($("#grid"), false);
        });
}

$(document).on("click", ".js-close-update", function () {
    var modal = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
    if (modal) modal.hide();
});

$(document).on("click", ".js-update-query", function () {
    kendo.ui.progress($("#updateModal"), true);
    $.ajax({
        url: "/Employee/UpdateQueryStatus",
        type: "POST",
        data: $("#updateForm").serialize(),
        success: function (res) {
            if (res && res.success) {
                var modal = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
                if (modal) modal.hide();
                $("#grid").data("kendoGrid").dataSource.read();
                kendo.notify("✅ Query updated successfully!", { type: "success" });
                return;
            }
            kendo.alert(res.message || "Failed to update query.");
        },
        error: function (xhr) {
            var message = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : "Failed to update query.";
            kendo.alert(message);
        }
    }).always(function() {
        kendo.ui.progress($("#updateModal"), false);
    });
});
</script>
}
