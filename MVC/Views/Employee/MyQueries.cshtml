@{
    ViewData["Title"] = "My Queries";
}

<style>
    /* ── Badges ── */
    .b { display: inline-flex; align-items: center; padding: 0.18rem 0.5rem; border-radius: 20px; font-size: 0.67rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
    .b-danger  { background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; }
    .b-warn    { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .b-success { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .b-muted   { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .b-blue    { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }

    /* ── Section card ── */
    .section-card {
        background: #fff; border-radius: 16px;
        border: 1px solid #e8edf3;
        box-shadow: 0 1px 4px rgba(15,23,42,0.05); overflow: hidden;
    }
    .section-card-header {
        padding: 1.1rem 1.4rem 0.9rem; border-bottom: 1px solid #f1f5f9;
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    }
    .section-card-title { font-size: 0.92rem; font-weight: 700; color: #0f172a; margin: 0; }
    .section-card-sub   { font-size: 0.73rem; color: #94a3b8; margin-top: 1px; }
    .section-card-body  { padding: 1.25rem 1.4rem; }

    /* ── Stat pills ── */
    .stat-pill {
        font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.7rem;
        border-radius: 20px; background: #f1f5f9; color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* ── Grid ── */
    .k-grid { border-radius: 8px; border: 1px solid #e8edf3; font-size: 0.83rem; }
    .k-grid-header th { font-weight: 700; background: #f8fafc; color: #374151; border-bottom-color: #e8edf3 !important; }
    .k-grid-content tr:hover td { background: #f8fafc; }
    .k-grid td { padding: 0.5rem 0.75rem; vertical-align: middle; }

    /* ── Search ── */
    .es-search-box {
        display: flex; align-items: center; gap: 10px;
        max-width: 420px; width: 100%; height: 40px; padding: 0 14px;
        background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px;
        transition: box-shadow 0.15s, border-color 0.15s;
    }
    .es-search-box:focus-within { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.12); background: #fff; }
    .es-icon { flex-shrink: 0; color: #94a3b8; }
    .es-input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; font-size: 0.85rem; color: #0f172a; }
    .es-input::placeholder { color: #94a3b8; }
    .es-clear {
        display: flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; padding: 0; border: none; border-radius: 50%;
        background: #e2e8f0; color: #475569; cursor: pointer; flex-shrink: 0;
    }
    .es-clear:hover { background: #cbd5e1; }
    .search-bar-wrap-inner { position: relative; flex: 1; }
    .search-bar-wrap-inner .search-icon {
        position: absolute; left: 0.7rem; top: 50%; transform: translateY(-50%);
        color: #94a3b8; font-size: 0.85rem; pointer-events: none;
    }
    .search-bar-input {
        width: 100%;
        padding: 0.5rem 0.85rem 0.5rem 2.4rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.85rem;
        background: #f8fafc;
        color: #0f172a;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-bar-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        background: #fff;
    }
    .emp-filter-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-bottom: 0.1rem;
    }
    .emp-filter-search {
        position: relative;
        flex: 1 1 280px;
        min-width: 240px;
    }
    .emp-filter-select,
    .emp-filter-date {
        padding: 0.48rem 0.85rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.83rem;
        background: #f8fafc;
        color: #374151;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .emp-filter-select {
        min-width: 150px;
        cursor: pointer;
    }
    .emp-filter-dates {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex: 0 0 auto;
    }
    .emp-filter-date { min-width: 160px; }
    .emp-filter-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: 0 0 auto;
    }
    .emp-filter-status {
        font-size: 0.75rem;
        color: #64748b;
        white-space: nowrap;
        flex: 0 0 auto;
    }
    @@media (max-width: 992px) {
        .emp-filter-bar {
            flex-wrap: wrap;
            overflow-x: visible;
        }
        .emp-filter-search,
        .emp-filter-dates,
        .emp-filter-actions {
            width: 100%;
        }
    }

    /* ── Modal ── */
    .modal-header-custom { background: #2563eb; padding: 1.1rem 1.4rem; border-bottom: none; border-radius: 14px 14px 0 0; }
    .modal-header-custom .modal-title { color: #fff; font-weight: 700; font-size: 0.95rem; }
    .modal-header-custom .btn-close { filter: invert(1) brightness(2); opacity: 0.8; }
</style>

<!-- Page heading -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2 text-primary"></i>My Queries</h4>
        <p class="text-muted mb-0 small">Assigned queries and their latest status</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <span class="stat-pill">Total: <span id="totalCount" class="text-primary">0</span></span>
        <span class="stat-pill">In Progress: <span id="progressCount" class="text-primary">0</span></span>
        <span class="stat-pill">Solved: <span id="solvedCount" class="text-success">0</span></span>
    </div>
</div>

<div class="section-card">
    <div class="section-card-body">
        <div class="emp-filter-bar mb-3">
            <div class="search-bar-wrap-inner emp-filter-search">
                <i class="bi bi-search search-icon"></i>
                <input id="querySearchInput" class="search-bar-input" type="text"
                       placeholder="Search queries by title, priority, status…" autocomplete="off" />
            </div>

            <select id="myFilterStatus" class="emp-filter-select">
                <option value="">All Statuses</option>
                <option value="InProgress">In Progress</option>
                <option value="Solved">Solved</option>
            </select>

            <div class="emp-filter-dates">
                <input type="date" id="myFromDate" aria-label="From date" title="From date" class="emp-filter-date" />
                <span style="font-size:0.83rem;color:#64748b;font-weight:600;">to</span>
                <input type="date" id="myToDate" aria-label="To date" title="To date" class="emp-filter-date" />
            </div>

            <div class="emp-filter-actions">
                <button id="myApplyFilterBtn" style="padding:0.48rem 1rem;border-radius:8px;font-size:0.83rem;font-weight:600;background:#2563eb;color:#fff;border:none;display:inline-flex;align-items:center;gap:0.4rem;cursor:pointer;transition:background 0.15s;">
                    <i class="bi bi-funnel-fill"></i> Filter
                </button>
                <button id="myResetFilterBtn" style="padding:0.48rem 0.85rem;border-radius:8px;font-size:0.83rem;font-weight:600;background:#f8fafc;color:#475569;border:1px solid #e2e8f0;display:inline-flex;align-items:center;gap:0.4rem;cursor:pointer;transition:background 0.15s;">
                    <i class="bi bi-x-lg"></i> Reset
                </button>
            </div>

            <span id="mySearchStatus" class="emp-filter-status"></span>
        </div>

        <div id="grid"></div>

        <!-- Back to Dashboard -->
        <div class="mt-3">
            <a asp-controller="Employee" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
            </a>
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:14px; border:none; box-shadow:0 20px 60px rgba(15,23,42,0.15);">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Update Query</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="updateModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var ELASTIC_SEARCH_ENABLED = true;
    var ELASTIC_SEARCH_URL     = "/Employee/SearchMyQueries";

    function priorityMeta(v) {
        if (v === 2 || v === "High")   return { text: "High",   cls: "b-danger" };
        if (v === 1 || v === "Medium") return { text: "Medium", cls: "b-warn" };
        return { text: "Low", cls: "b-success" };
    }
    function statusMeta(v) {
        if (v === 2 || v === "Solved")                              return { text: "Solved",      cls: "b-success" };
        if (v === 1 || v === "InProgress" || v === "In Progress")   return { text: "In Progress", cls: "b-blue" };
        return { text: "Open", cls: "b-muted" };
    }

    function updateStats(data) {
        $("#totalCount").text(data.length);
        $("#progressCount").text(data.filter(function(d) { return statusMeta(d.status).text === "In Progress"; }).length);
        $("#solvedCount").text(data.filter(function(d) { return statusMeta(d.status).text === "Solved"; }).length);
    }

    function renderGrid(data) {
        updateStats(data);
        var grid = $("#grid").data("kendoGrid");
        if (grid) { grid.dataSource.data(data); grid.dataSource.page(1); return; }
        $("#grid").kendoGrid({
            dataSource: { data: data, pageSize: 10 },
            sortable:   true,
            scrollable: false,
            pageable:   { pageSizes: [5, 10, 15], refresh: true },
            noRecords:  { template: "No queries found." },
            dataBound:  function () { updateStats(this.dataSource.data()); },
            columns: [
                { field: "queryId",  title: "ID",       width: 80 },
                { field: "title",    title: "Title",    minWidth: 200 },
                { field: "priority", title: "Priority", width: 110,
                  template: function(d) { var m = priorityMeta(d.priority); return "<span class='b " + m.cls + "'>" + m.text + "</span>"; }},
                { field: "status",   title: "Status",   width: 130,
                  template: function(d) { var m = statusMeta(d.status); return "<span class='b " + m.cls + "'>" + m.text + "</span>"; }},
                { field: "comments", title: "Comments", minWidth: 200,
                  template: function(d) { return kendo.htmlEncode(d.comments || "\u2014"); }},
                { title: "Action", width: 110,
                  template: function(d) {
                      // Only show Update button for In Progress queries
                      if (statusMeta(d.status).text === "Solved") {
                          return "<span class='text-muted small'>—</span>";
                      }
                      return "<button type='button' class='btn btn-sm btn-outline-primary' onclick='openUpdate(" + d.queryId + ")'>Update</button>";
                  }}
            ]
        });
    }

    var allData = [], searchTimer = null, activeMyRequest = null;

    function setMySearchBusy(busy) {
        $("#myApplyFilterBtn").prop("disabled", busy).html(
            busy ? '<span class="spinner-border spinner-border-sm me-1"></span>Searching…'
                 : '<i class="bi bi-funnel-fill"></i> Filter'
        );
    }

    function updateMySearchStatus(count) {
        $("#mySearchStatus").text(count === null ? "" : count + " result" + (count !== 1 ? "s" : ""));
    }

    function runMyElasticSearch() {
        var q        = $("#querySearchInput").val().trim();
        var status   = $("#myFilterStatus").val();
        var fromDate = $("#myFromDate").val();
        var toDate   = $("#myToDate").val();

        if (!q && !status && !fromDate && !toDate) {
            renderGrid(allData);
            updateMySearchStatus(null);
            setMySearchBusy(false);
            return;
        }

        if (activeMyRequest) { activeMyRequest.abort(); activeMyRequest = null; }

        setMySearchBusy(true);
        $("#mySearchStatus").text("Searching…");

        var params = {};
        if (q)        params.q        = q;
        if (status)   params.status   = status;
        if (fromDate) params.fromDate = fromDate;
        if (toDate)   params.toDate   = toDate;

        activeMyRequest = $.get("/Employee/SearchMyQueries", params)
            .done(function (results) {
                activeMyRequest = null;

                if (results && results.error) {
                    setMySearchBusy(false);
                    updateMySearchStatus(null);
                    return;
                }

                var mapped = (results || []).map(function(r) {
                    return {
                        queryId:   r.queryId,
                        title:     r.title     || "",
                        priority:  r.priority  || "",
                        status:    r.status    || "",
                        queryDate: r.queryDate ? new Date(r.queryDate) : new Date(),
                        comments:  r.comments  || ""
                    };
                });

                renderGrid(mapped);
                updateMySearchStatus(mapped.length);
                setMySearchBusy(false);
            })
            .fail(function (xhr) {
                activeMyRequest = null;
                if (xhr.statusText === "abort") return;
                setMySearchBusy(false);
                updateMySearchStatus(null);
            });
    }

    $("#querySearchInput").on("input", function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(runMyElasticSearch, 350);
    });

    $("#myApplyFilterBtn")
        .hover(
            function() { $(this).css("background", "#1d4ed8"); },
            function() { $(this).css("background", "#2563eb"); })
        .on("click", function () {
            clearTimeout(searchTimer);
            runMyElasticSearch();
        });

    $("#myResetFilterBtn")
        .hover(
            function() { $(this).css("background", "#f1f5f9"); },
            function() { $(this).css("background", "#f8fafc"); })
        .on("click", function () {
            clearTimeout(searchTimer);
            if (activeMyRequest) { activeMyRequest.abort(); activeMyRequest = null; }
            $("#querySearchInput").val("");
            $("#myFilterStatus").val("");
            $("#myFromDate").val("");
            $("#myToDate").val("");
            updateMySearchStatus(null);
            setMySearchBusy(false);
            renderGrid(allData);
        });

    $("#myFilterStatus, #myFromDate, #myToDate").on("focus", function() {
        $(this).css({ "border-color": "#3b82f6", "box-shadow": "0 0 0 3px rgba(59,130,246,0.12)", "background": "#fff" });
    }).on("blur", function() {
        $(this).css({ "border-color": "#e2e8f0", "box-shadow": "none", "background": "#f8fafc" });
    });

    $(function () {
        $.getJSON("/Employee/GetMyQueries")
            .done(function(data) { allData = data; renderGrid(data); })
            .fail(function() { $("#grid").text("Failed to load queries."); });
    });

    function openUpdate(id) {
        kendo.ui.progress($("#grid"), true);
        $.get("/Employee/UpdateQuery", { id: id })
            .done(function(html) {
                $("#updateModalBody").html(html);
                new bootstrap.Modal(document.getElementById("updateModal"), { backdrop: "static" }).show();
            })
            .fail(function(xhr) { alert(xhr.responseText || "Failed to open update form."); })
            .always(function() { kendo.ui.progress($("#grid"), false); });
    }

    $(document).on("click", ".js-close-update", function () {
        var m = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
        if (m) m.hide();
    });
    $(document).on("click", ".js-update-query", function () {
        kendo.ui.progress($("#updateModal"), true);
        $.ajax({
            url: "/Employee/UpdateQueryStatus", type: "POST", data: $("#updateForm").serialize(),
            success: function(res) {
                if (res && res.success) {
                    bootstrap.Modal.getInstance(document.getElementById("updateModal")).hide();
                    $.getJSON("/Employee/GetMyQueries").done(function(data) {
                        allData = data;
                        runMyElasticSearch();
                    });
                    return;
                }
                alert(res.message || "Failed to update query.");
            },
            error: function(xhr) { alert((xhr.responseJSON && xhr.responseJSON.message) || "Failed to update query."); },
            complete: function() { kendo.ui.progress($("#updateModal"), false); }
        });
    });
</script>
}
