@model Repository.Models.Query

<style>
    .update-wrapper { padding: 0.5rem 0; }
    .form-label-custom { font-size: 0.8rem; font-weight: 700; color: #374151; margin-bottom: 0.3rem; display: block; }
    .form-control-custom {
        width: 100%; padding: 0.55rem 0.85rem;
        border: 1.5px solid #e2e8f0; border-radius: 8px;
        font-size: 0.875rem; color: #0f172a; background: #f8fafc; outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-control-custom:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        background: #fff;
    }
    .form-control-custom.is-invalid { border-color: #f43f5e !important; box-shadow: 0 0 0 3px rgba(244,63,94,0.1) !important; }
    .field-error { font-size: 0.75rem; color: #f43f5e; margin-top: 0.3rem; display: none; }
    .query-meta { background: #f8fafc; border-radius: 10px; padding: 1rem 1.1rem; margin-bottom: 1.25rem; border: 1px solid #e8edf3; }
    .query-meta-id { font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-bottom: 0.2rem; }
    .query-meta-title { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 0.3rem; }
    .query-meta-desc { font-size: 0.83rem; color: #64748b; line-height: 1.5; margin: 0; }
</style>

<div class="update-wrapper">
    <div class="query-meta">
        <div class="query-meta-id">Query #@Model.QueryId</div>
        <div class="query-meta-title">@Model.Title</div>
        <p class="query-meta-desc">@Model.Description</p>
    </div>

    <form id="updateForm">
        <input type="hidden" name="QueryId" value="@Model.QueryId" />

        <div class="mb-3">
            <label class="form-label-custom" for="statusDdl">Status</label>
            <select id="statusDdl" name="Status" class="form-control-custom">
                @if (Model.Status == Repository.Models.Enums.QueryStatus.InProgress)
                {
                    <option value="InProgress" selected>In Progress</option>
                    <option value="Solved">Solved</option>
                }
                else
                {
                    <option value="InProgress">In Progress</option>
                    <option value="Solved" selected>Solved</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label-custom" for="commentBox">
                Comments <span id="commentRequired" class="text-danger" style="display:none;">*</span>
            </label>
            <textarea id="commentBox" name="Comments" class="form-control-custom"
                      rows="4" placeholder="Enter comments…">@Model.Comments</textarea>
            <div class="field-error" id="commentError">Comments are required when marking as Solved.</div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-2">
            <button type="button" class="btn btn-sm btn-outline-secondary js-close-update">Cancel</button>
            <button type="button" id="updateBtn" class="btn btn-sm btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i>Update
            </button>
        </div>
    </form>
</div>

<script>
    document.getElementById("statusDdl").addEventListener("change", function () {
        var isSolved = this.value === "Solved";
        document.getElementById("commentRequired").style.display = isSolved ? "inline" : "none";
        if (!isSolved) {
            document.getElementById("commentBox").classList.remove("is-invalid");
            document.getElementById("commentError").style.display = "none";
        }
    });
    document.getElementById("statusDdl").dispatchEvent(new Event("change"));

    document.getElementById("updateBtn").addEventListener("click", function () {
        var status   = document.getElementById("statusDdl").value;
        var comments = (document.getElementById("commentBox").value || "").trim();

        if (status === "Solved" && comments.length === 0) {
            document.getElementById("commentBox").classList.add("is-invalid");
            document.getElementById("commentError").style.display = "block";
            document.getElementById("commentBox").focus();
            return; // stop here
        }

        document.getElementById("commentBox").classList.remove("is-invalid");
        document.getElementById("commentError").style.display = "none";

        // Submit directly — no dependency on parent handler
        var $btn = $("#updateBtn");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span>Updating…');

        $.ajax({
            url: "/Employee/UpdateQueryStatus",
            type: "POST",
            data: $("#updateForm").serialize(),
            success: function (res) {
                if (res && res.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
                    if (modal) modal.hide();
                    // Refresh parent grid
                    $.getJSON("/Employee/GetMyQueries").done(function (data) {
                        if (typeof allData !== "undefined") allData = data;
                        if (typeof renderGrid === "function") {
                            // On Dashboard: show only In Progress; on MyQueries: show all
                            var gridData = (typeof doSearch === "function" && window.location.pathname.indexOf("MyQueries") >= 0)
                                ? data
                                : data.filter(function(q) { return statusMeta(q.status).text === "In Progress"; });
                            renderGrid(gridData);
                        }
                    });
                    return;
                }
                alert((res && res.message) || "Failed to update query.");
                $btn.prop("disabled", false).html('<i class="bi bi-check-lg me-1"></i>Update');
            },
            error: function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || "Failed to update query.");
                $btn.prop("disabled", false).html('<i class="bi bi-check-lg me-1"></i>Update');
            }
        });
    });
</script>
